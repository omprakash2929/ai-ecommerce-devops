pipeline {
    agent any

    // GitHub Push -> Jenkins Trigger (polls the repo every 2 minutes)
    triggers {
        pollSCM('H/2 * * * *')
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        DOCKERHUB_USER = 'omprakash2929'         
        IMAGE_NAME     = "${DOCKERHUB_USER}/nexvion"
        IMAGE_TAG      = "${BUILD_NUMBER}"
        KUBECONFIG     = '/var/lib/jenkins/.kube/config'
        K8S_NAMESPACE  = 'nexvion'
        NODE_PORT      = '30080'
        NODE_RUN       = 'docker run --rm --user 1000:1000 -e HOME=/tmp -e npm_config_cache=/src/.npm-cache -v $WORKSPACE:/src -w /src node:20-alpine'
    }

    stages {

        stage('Checkout Source') {
            steps {
                checkout scm
                sh 'ls -la'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '$NODE_RUN npm install --no-audit --no-fund'
            }
        }

        stage('Build') {
            steps {
                sh '''
                    rm -rf dist && mkdir -p dist
                    cp -r application/. dist/
                    tar czf nexvion-${BUILD_NUMBER}.tgz -C dist .
                '''
                archiveArtifacts artifacts: 'nexvion-*.tgz', fingerprint: true
            }
        }

        stage('Test') {
            steps {
                sh '''
                    $NODE_RUN npm run lint
                    $NODE_RUN npm test
                    docker run --rm -v "$WORKSPACE:/src" -w /src alpine/helm:latest lint helm/ecommerce
                '''
            }
        }

        stage('Security Checks') {
            parallel {
                stage('Secret Scan (Gitleaks)') {
                    steps {
                        sh '''
                            docker run --rm -v "$WORKSPACE:/repo" zricethezav/gitleaks:latest \
                                detect --no-git --source=/repo --redact --exit-code 1
                        '''
                    }
                }
                stage('Dependency Scan (Trivy fs)') {
                    steps {
                        sh '''
                            docker run --rm -v "$WORKSPACE:/src" -v trivy-cache:/root/.cache/ \
                                aquasec/trivy:latest fs \
                                --skip-dirs /src/node_modules --skip-dirs /src/.npm-cache \
                                --exit-code 1 --severity HIGH,CRITICAL /src
                        '''
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build -f docker/Dockerfile \
                        -t ${IMAGE_NAME}:${IMAGE_TAG} \
                        -t ${IMAGE_NAME}:latest .
                '''
            }
        }

        stage('Image Scan') {
            steps {
                sh '''
                    docker run --rm \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        -v trivy-cache:/root/.cache/ \
                        aquasec/trivy:latest image \
                        --exit-code 1 --severity HIGH,CRITICAL --ignore-unfixed \
                        ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Push Image') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds',
                                                  usernameVariable: 'DH_USER',
                                                  passwordVariable: 'DH_PASS')]) {
                    sh '''
                        echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin
                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                        docker push ${IMAGE_NAME}:latest
                        docker logout
                    '''
                }
            }
        }

        stage('Deploy to k3s (Helm)') {
            steps {
                sh '''
                    helm upgrade --install nexvion helm/ecommerce \
                        --namespace ${K8S_NAMESPACE} --create-namespace \
                        --set image.repository=${IMAGE_NAME} \
                        --set image.tag=${IMAGE_TAG} \
                        --atomic --timeout 3m

                    kubectl -n ${K8S_NAMESPACE} rollout status deployment/nexvion --timeout=120s
                    kubectl -n ${K8S_NAMESPACE} get pods,svc,ingress
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    for i in $(seq 1 10); do
                        if bash scripts/smoke-test.sh http://localhost:${NODE_PORT}; then
                            exit 0
                        fi
                        echo "App not ready yet, retry $i/10..."
                        sleep 5
                    done
                    echo "Health check failed"
                    exit 1
                '''
            }
        }

        stage('Deployment Success') {
            steps {
                echo "Nexvion ${IMAGE_NAME}:${IMAGE_TAG} is live on k3s (NodePort ${NODE_PORT})"
            }
        }
    }

    post {
        failure {
            echo 'Pipeline FAILED - open the red stage and read its log.'
            sh 'kubectl -n ${K8S_NAMESPACE} get pods || true'
        }
        always {
            sh 'docker image prune -f || true'
        }
    }
}
