// Infra validation pipeline (separate Jenkins job, Script Path: jenkins/Jenkinsfile.infra)
// Terraform ko VM par install karne ki zaroorat nahi - containers use hote hain.
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Terraform fmt + validate') {
            steps {
                sh '''
                    TF="docker run --rm --user $(id -u):$(id -g) -e HOME=/tmp -v $WORKSPACE/terraform:/tf -w /tf hashicorp/terraform:1.9"
                    $TF fmt -check -recursive
                    $TF init -backend=false -input=false
                    $TF validate
                '''
            }
        }

        stage('Terraform security scan (Trivy config)') {
            steps {
                sh '''
                    docker run --rm -v "$WORKSPACE:/src" -v trivy-cache:/root/.cache/ \
                        aquasec/trivy:latest config --no-progress \
                        --severity HIGH,CRITICAL --exit-code 1 /src/terraform
                '''
            }
        }

        stage('Ansible syntax check') {
            steps {
                sh '''
                    docker run --rm -v "$WORKSPACE/ansible:/ansible" -w /ansible python:3.12-slim sh -c "
                        pip install -q ansible-core &&
                        ansible-galaxy collection install -r requirements.yml &&
                        ansible-playbook playbook.yml --syntax-check
                    "
                '''
            }
        }
    }

    post {
        success { echo 'Terraform and Ansible code validated.' }
        failure { echo 'Infra validation FAILED - check the red stage.' }
    }
}
